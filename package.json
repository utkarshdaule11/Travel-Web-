{
  "name": "young-tours-and-travels",
  "version": "1.0.0",
  "description": "Young Tours & Travels Platform - Production Engineering Baseline",
  "private": true,
  "type": "module",
  "main": "dist/backend/src/server.js",
  "scripts": {
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:worker": "tsx watch worker/src/index.ts",
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -b",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{backend,worker,shared,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{backend,worker,shared,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"{backend,worker,shared,tests,frontend,docs}/**/*.{ts,js,html,css,json,md}\"",
    "format:check": "prettier --check \"{backend,worker,shared,tests,frontend,docs}/**/*.{ts,js,html,css,json,md}\"",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --fileParallelism=false",
    "db:migrate": "tsx backend/src/infrastructure/database/migrator.ts",
    "db:seed": "tsx backend/src/infrastructure/database/seeds/seedAll.ts",
    "db:seed:admin": "tsx backend/src/infrastructure/database/seeds/seedAdmin.ts",
    "db:seed:catalogue": "tsx backend/src/infrastructure/database/seeds/seedCatalogue.ts",
    "seed": "tsx backend/src/infrastructure/database/seeds/seedAll.ts"
  },
  "keywords": [
    "tours-and-travels",
    "fastify",
    "typescript",
    "postgresql",
    "redis",
    "bullmq"
  ],
  "author": "Young Tours & Travels Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
